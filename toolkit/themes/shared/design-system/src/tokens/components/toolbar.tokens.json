{
  "padding": {
    "inline": {
      "value": "8px"
    }
  },
  "field": {
    "border": {
      "color": {
        "@base": {
          "value": {
            "light": "#cccccc",
            "dark": "rgba(249, 249, 250, 0.2)",
            "prefersContrast": "{input.border.color}"
          }
        },
        "focus": {
          "value": {
            "default": "color-mix(in srgb, {focus.outline.color} 50%, transparent)",
            "prefersContrast": "{focus.outline.color}"
          }
        }
      }
    },
    "background": {
      "color": {
        "@base": {
          "value": {
            "light": "{color.white.@base}",
            "dark": "rgb(71, 71, 73)",
            "prefersContrast": "Field"
          }
        },
        "focus": {
          "value": {
            "light": "{color.white.@base}",
            "dark": "rgb(74, 74, 79)",
            "nativeTheme": "Field"
          }
        }
      }
    },
    "text": {
      "color": {
        "@base": {
          "value": {
            "light": "rgb(12, 12, 13)",
            "dark": "rgb(249, 249, 250)",
            "nativeTheme": "inherit",
            "prefersContrast": "FieldText"
          }
        },
        "focus": {
          "value": {
            "light": "rgb(12, 12, 13)",
            "dark": "rgb(249, 249, 250)",
            "nativeTheme": "FieldText"
          }
        }
      }
    }
  },
  "background": {
    "color": {
      "value": {
        "light": "#f9f9fa",
        "dark": "hsl(240, 1%, 20%)",
        "nativeTheme": "color-mix(in srgb, -moz-dialog 85%, {color.white.@base})"
      }
    }
  },
  "text": {
    "color": {
      "value": {
        "light": "rgb(12, 12, 13)",
        "dark": "rgb(249, 249, 250)",
        "nativeTheme": "-moz-dialogtext"
      }
    }
  }
}
